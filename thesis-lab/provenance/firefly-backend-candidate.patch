diff --git a/tests/test_commander_analytics_projection.py b/tests/test_commander_analytics_projection.py
new file mode 100644
index 0000000..349e15a
--- /dev/null
+++ b/tests/test_commander_analytics_projection.py
@@ -0,0 +1,246 @@
+from datetime import UTC, date, datetime, timedelta
+import asyncio
+
+import pytest
+from sqlalchemy import text
+from sqlalchemy.ext.asyncio import async_sessionmaker
+from app.modules.commander import analytics_projection as p
+from app.modules.commander.service import (
+    get_airline_competency_grade_distribution as distribution,
+)
+from app.modules.training import models as m
+from app.modules.training.assessment_models import (
+    TrainingSession,
+    CrewMemberAssessment,
+    FinalReport,
+)
+from app.modules.users.models import User, UserAircraft
+
+
+async def seed(s):
+    airline = m.Airline(code="TP", name="Projection test", active=True)
+    other = m.Airline(code="TP2", name="Other tenant", active=True)
+    s.add_all([airline, other])
+    await s.flush()
+    aircraft = m.AircraftAirline(airline_id=airline.id, code="A320")
+    scheme = m.GradingScheme(airline_id=airline.id, name="Test", version=1, is_active=True)
+    comp = m.Competence(airline_id=airline.id, code="TEST", name="Test competence")
+    users = [
+        User(
+            airline_id=a.id,
+            login=f"pilot{i}",
+            email=f"p{i}@example.com",
+            hashed_password="!",
+        )
+        for i, a in enumerate((airline, airline, other))
+    ]
+    s.add_all([aircraft, scheme, comp, *users])
+    await s.flush()
+    s.add_all([UserAircraft(user_id=u.id, aircraft_id=aircraft.id) for u in users])
+    trainings = []
+    assessments = []
+    for i in range(6):
+        ts = datetime(2020, 1, 1, tzinfo=UTC) + timedelta(days=i)
+        t = TrainingSession(
+            grading_scheme_id=scheme.id,
+            status="COMPLETED",
+            completed_at=ts,
+            created_at=ts,
+            updated_at=ts,
+        )
+        s.add(t)
+        await s.flush()
+        trainings.append(t)
+        a = CrewMemberAssessment(
+            training_session_id=t.id,
+            user_id=users[i % 3].id,
+            training_role="cm1",
+            created_at=ts,
+        )
+        s.add(a)
+        await s.flush()
+        assessments.append(a)
+        s.add(
+            FinalReport(
+                assessment_id=a.id,
+                competence_id=comp.id,
+                grade=str(i % 4 + 1),
+                grade_code_snapshot=str(i % 4 + 1),
+                created_at=ts,
+                updated_at=ts,
+            )
+        )
+    await s.commit()
+    await p.install(s)
+    await p.enqueue_rebuild(s)
+    while await p.process_batch(s):
+        pass
+    return airline, other, users, comp, trainings, assessments
+
+
+async def check(s, aid, **filters):
+    kwargs = dict(
+        airline_id=aid,
+        pilot_public_id=None,
+        aircraft_id=None,
+        age_from_years=None,
+        age_to_years=None,
+        position_id=None,
+        as_of_date=None,
+    )
+    kwargs.update(filters)
+    a = await distribution(s, **kwargs)
+    b = await distribution(s, **kwargs, use_projection=True)
+    assert a == b
+    return b
+
+
+@pytest.mark.asyncio
+async def test_projection_preserves_tenant_latest_and_asof(db_session):
+    aid, other, users, comp, ts, ass = await seed(db_session)
+    result = await check(db_session, aid.id)
+    assert result["total_pilots"] == 2
+    assert result["pilots_with_completed_training"] == 2
+    for cutoff in (date(2019, 12, 31), date(2020, 1, 2), date(2021, 1, 1)):
+        await check(db_session, aid.id, as_of_date=cutoff)
+    await check(db_session, other.id)
+
+
+@pytest.mark.asyncio
+async def test_projection_tracks_grade_correction_and_duplicate_delivery(db_session):
+    aid, other, users, comp, ts, ass = await seed(db_session)
+    s = db_session
+    await s.execute(
+        text("UPDATE final_report SET grade='4',grade_code_snapshot='4' WHERE assessment_id=:id"),
+        {"id": ass[4].id},
+    )
+    for _ in range(3):
+        await s.execute(text("SELECT commander_mark_dirty(:u)"), {"u": users[1].id})
+    await s.commit()
+    assert await s.scalar(text("SELECT count(*) FROM commander_dirty_pilot")) == 1
+    assert len(await p.process_batch(s)) == 1
+    assert await p.process_batch(s) == []
+    await check(s, aid.id)
+
+
+@pytest.mark.asyncio
+async def test_projection_retains_latest_report_tie_breaker(db_session):
+    aid, other, users, comp, ts, ass = await seed(db_session)
+    s = db_session
+    stamp = datetime(2020, 1, 10, tzinfo=UTC)
+    for grade in ("2", "3"):
+        s.add(
+            FinalReport(
+                assessment_id=ass[4].id,
+                competence_id=comp.id,
+                grade=grade,
+                created_at=stamp,
+                updated_at=stamp,
+            )
+        )
+    await s.commit()
+    await p.process_batch(s)
+    result = await check(s, aid.id)
+    assert any(
+        g["grade_code"] == "3" and g["pilot_count"] == 1 for g in result["items"][0]["grades"]
+    )
+
+
+@pytest.mark.asyncio
+async def test_projection_tracks_status_undo_and_cascade_deletion(db_session):
+    aid, other, users, comp, ts, ass = await seed(db_session)
+    s = db_session
+    await s.execute(
+        text("UPDATE training_session SET status='IN_PROGRESS' WHERE id=:id"),
+        {"id": ts[4].id},
+    )
+    await s.commit()
+    await p.process_batch(s)
+    await check(s, aid.id)
+    await s.execute(text("DELETE FROM training_session WHERE id=:id"), {"id": ts[3].id})
+    await s.commit()
+    await p.process_batch(s)
+    await check(s, aid.id)
+    await p.enqueue_rebuild(s)
+    while await p.process_batch(s):
+        pass
+    await check(s, aid.id)
+
+
+@pytest.mark.asyncio
+async def test_projection_source_rollback_publishes_no_work(db_session):
+    aid, other, users, comp, ts, ass = await seed(db_session)
+    s = db_session
+    a_id = aid.id
+    await s.execute(text("UPDATE final_report SET grade='4'"))
+    await s.rollback()
+    assert await s.scalar(text("SELECT count(*) FROM commander_dirty_pilot")) == 0
+    await check(s, a_id)
+
+
+@pytest.mark.asyncio
+async def test_projection_worker_failure_rolls_back_facts_and_retains_queue(
+    db_session, monkeypatch
+):
+    aid, other, users, comp, ts, ass = await seed(db_session)
+    s = db_session
+    a_id = aid.id
+    await s.execute(text("UPDATE final_report SET grade='4',grade_code_snapshot='4'"))
+    await s.commit()
+    old = await s.scalar(text("SELECT count(*) FROM commander_grade_fact"))
+
+    async def fail():
+        raise RuntimeError("Injected crash before commit")
+
+    with monkeypatch.context() as patch:
+        patch.setattr(s, "commit", fail)
+        with pytest.raises(RuntimeError, match="Injected crash"):
+            await p.process_batch(s)
+    await s.rollback()
+    assert await s.scalar(text("SELECT count(*) FROM commander_grade_fact")) == old
+    assert await s.scalar(text("SELECT count(*) FROM commander_dirty_pilot")) == 3
+    await p.process_batch(s)
+    await check(s, a_id)
+
+
+@pytest.mark.asyncio
+async def test_concurrent_source_write_is_not_erased_by_worker_ack(db_session):
+    aid, other, users, comp, ts, ass = await seed(db_session)
+    airline_id, assessment_id = aid.id, ass[4].id
+    await db_session.execute(
+        text("UPDATE final_report SET grade='2',grade_code_snapshot='2' WHERE assessment_id=:a"),
+        {'a': assessment_id},
+    )
+    await db_session.commit()
+    factory = async_sessionmaker(db_session.bind, expire_on_commit=False)
+    reached, release = asyncio.Event(), asyncio.Event()
+    async with factory() as worker:
+        commit = worker.commit
+
+        async def delayed_commit():
+            reached.set()
+            await release.wait()
+            await commit()
+
+        worker.commit = delayed_commit
+        task = asyncio.create_task(p.process_batch(worker))
+        await asyncio.wait_for(reached.wait(), 10)
+
+        async def later_write():
+            async with factory() as source:
+                await source.execute(
+                    text(
+                        "UPDATE final_report SET grade='3',grade_code_snapshot='3' WHERE assessment_id=:a"
+                    ),
+                    {'a': assessment_id},
+                )
+                await source.commit()
+
+        write_task = asyncio.create_task(later_write())
+        await asyncio.sleep(0.05)
+        release.set()
+        await asyncio.wait_for(task, 10)
+        await asyncio.wait_for(write_task, 10)
+    assert await db_session.scalar(text('SELECT count(*) FROM commander_dirty_pilot')) == 1
+    await p.process_batch(db_session)
+    await check(db_session, airline_id)
