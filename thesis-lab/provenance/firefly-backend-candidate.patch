--- /dev/null
+++ b/app/modules/commander/analytics_projection.py
@@ -0,0 +1,238 @@
+"""Experimental read model for competency grade distribution.
+
+Opt-in installation only. Source writes and dirty-pilot publication share the
+PostgreSQL transaction. A worker rebuilds only affected pilots, retaining dated
+facts for as-of queries. Existing user/tenant filters remain authoritative.
+"""
+
+from __future__ import annotations
+
+from datetime import date, datetime, time, timedelta, UTC
+from sqlalchemy import (
+    BigInteger,
+    DateTime,
+    String,
+    Numeric,
+    MetaData,
+    Table,
+    Column,
+    select,
+    func,
+    literal,
+    text,
+)
+
+metadata = MetaData()
+facts = Table(
+    "commander_assessment_fact",
+    metadata,
+    Column("assessment_id", BigInteger, primary_key=True),
+    Column("user_id", BigInteger),
+    Column("training_id", BigInteger),
+    Column("effective_at", DateTime(timezone=True)),
+    Column("assessment_created_at", DateTime(timezone=True)),
+)
+latest = Table(
+    "commander_latest_assessment",
+    metadata,
+    Column("user_id", BigInteger, primary_key=True),
+    Column("assessment_id", BigInteger),
+)
+grades = Table(
+    "commander_grade_fact",
+    metadata,
+    Column("assessment_id", BigInteger, primary_key=True),
+    Column("competence_id", BigInteger, primary_key=True),
+    Column("grade_code", String),
+    Column("grade_label", String),
+    Column("grade_score_numeric", Numeric),
+    Column("grade_color_hex", String),
+)
+
+DDL = [
+    """CREATE TABLE IF NOT EXISTS commander_dirty_pilot (
+       user_id bigint PRIMARY KEY, changed_at timestamptz NOT NULL DEFAULT clock_timestamp())""",
+    """CREATE TABLE IF NOT EXISTS commander_assessment_fact (
+       assessment_id bigint PRIMARY KEY, user_id bigint NOT NULL, training_id bigint NOT NULL,
+       effective_at timestamptz NOT NULL, assessment_created_at timestamptz NOT NULL)""",
+    """CREATE INDEX IF NOT EXISTS commander_fact_user_date ON commander_assessment_fact
+       (user_id,effective_at DESC,assessment_created_at DESC,assessment_id DESC)""",
+    """CREATE TABLE IF NOT EXISTS commander_latest_assessment (user_id bigint PRIMARY KEY, assessment_id bigint NOT NULL)""",
+    """CREATE TABLE IF NOT EXISTS commander_grade_fact (
+       assessment_id bigint NOT NULL REFERENCES commander_assessment_fact(assessment_id) ON DELETE CASCADE,
+       competence_id bigint NOT NULL, grade_code text,grade_label text,grade_score_numeric numeric,
+       grade_color_hex text, PRIMARY KEY(assessment_id,competence_id))""",
+    """CREATE OR REPLACE FUNCTION commander_mark_dirty(pilot bigint) RETURNS void LANGUAGE plpgsql AS $$
+       BEGIN
+         IF pilot IS NOT NULL THEN
+           INSERT INTO commander_dirty_pilot(user_id) VALUES(pilot)
+           ON CONFLICT(user_id) DO UPDATE SET changed_at=LEAST(commander_dirty_pilot.changed_at,EXCLUDED.changed_at);
+         END IF;
+       END $$""",
+    """CREATE OR REPLACE FUNCTION commander_source_changed() RETURNS trigger LANGUAGE plpgsql AS $$
+       DECLARE pilot bigint;
+       BEGIN
+         IF TG_TABLE_NAME='crew_member_assessment' THEN
+           IF TG_OP <> 'INSERT' THEN PERFORM commander_mark_dirty(OLD.user_id); END IF;
+           IF TG_OP <> 'DELETE' THEN PERFORM commander_mark_dirty(NEW.user_id); END IF;
+         ELSIF TG_TABLE_NAME='final_report' THEN
+           IF TG_OP <> 'INSERT' THEN
+             SELECT user_id INTO pilot FROM crew_member_assessment WHERE id=OLD.assessment_id;
+             PERFORM commander_mark_dirty(pilot);
+           END IF;
+           IF TG_OP <> 'DELETE' THEN
+             SELECT user_id INTO pilot FROM crew_member_assessment WHERE id=NEW.assessment_id;
+             PERFORM commander_mark_dirty(pilot);
+           END IF;
+         ELSE
+           FOR pilot IN SELECT DISTINCT user_id FROM crew_member_assessment WHERE training_session_id=OLD.id LOOP
+             PERFORM commander_mark_dirty(pilot);
+           END LOOP;
+         END IF;
+         IF TG_OP='DELETE' THEN RETURN OLD; END IF;
+         RETURN NEW;
+       END $$""",
+]
+
+
+async def install(session):
+    for statement in DDL:
+        await session.execute(text(statement))
+    for table, events in [
+        ("crew_member_assessment", "INSERT OR UPDATE OR DELETE"),
+        ("final_report", "INSERT OR UPDATE OR DELETE"),
+        ("training_session", "UPDATE OR DELETE"),
+    ]:
+        await session.execute(text(f"DROP TRIGGER IF EXISTS commander_dirty ON {table}"))
+        await session.execute(
+            text(
+                f"CREATE TRIGGER commander_dirty BEFORE {events} ON {table} "
+                "FOR EACH ROW EXECUTE FUNCTION commander_source_changed()"
+            )
+        )
+    await session.commit()
+
+
+async def enqueue_rebuild(session):
+    # Also rebuild/remove pilots no longer present in source.
+    await session.execute(
+        text(
+            """INSERT INTO commander_dirty_pilot(user_id)
+        SELECT user_id FROM crew_member_assessment WHERE user_id IS NOT NULL
+        UNION SELECT user_id FROM commander_assessment_fact
+        ON CONFLICT(user_id) DO NOTHING"""
+        )
+    )
+    await session.commit()
+
+
+async def process_batch(session, limit=100):
+    """One atomic, restart-safe batch. Concurrent source writes re-enqueue pilots."""
+    rows = (
+        await session.execute(
+            text(
+                """SELECT user_id,changed_at FROM commander_dirty_pilot
+        ORDER BY user_id LIMIT :limit FOR UPDATE SKIP LOCKED"""
+            ),
+            {"limit": limit},
+        )
+    ).all()
+    if not rows:
+        await session.commit()
+        return []
+    ids = [r.user_id for r in rows]
+    params = {"ids": ids}
+    await session.execute(
+        text("DELETE FROM commander_assessment_fact WHERE user_id=ANY(:ids)"), params
+    )
+    await session.execute(
+        text("DELETE FROM commander_latest_assessment WHERE user_id=ANY(:ids)"), params
+    )
+    await session.execute(
+        text(
+            """INSERT INTO commander_assessment_fact
+        SELECT a.id,a.user_id,t.id,coalesce(t.completed_at,t.updated_at,t.created_at),a.created_at
+        FROM crew_member_assessment a JOIN training_session t ON t.id=a.training_session_id
+        WHERE a.user_id=ANY(:ids) AND t.status='COMPLETED' """
+        ),
+        params,
+    )
+    await session.execute(
+        text(
+            """INSERT INTO commander_latest_assessment
+        SELECT DISTINCT ON(user_id) user_id,assessment_id FROM commander_assessment_fact
+        WHERE user_id=ANY(:ids)
+        ORDER BY user_id,effective_at DESC,assessment_created_at DESC,assessment_id DESC"""
+        ),
+        params,
+    )
+    await session.execute(
+        text(
+            """INSERT INTO commander_grade_fact
+        SELECT DISTINCT ON(r.assessment_id,r.competence_id)
+          r.assessment_id,r.competence_id,coalesce(r.grade_code_snapshot,r.grade),
+          r.grade_label_snapshot,r.grade_score_snapshot,r.grade_color_hex_snapshot
+        FROM final_report r JOIN commander_assessment_fact a ON a.assessment_id=r.assessment_id
+        WHERE a.user_id=ANY(:ids)
+        ORDER BY r.assessment_id,r.competence_id,r.updated_at DESC,r.created_at DESC,r.id DESC"""
+        ),
+        params,
+    )
+    await session.execute(text("DELETE FROM commander_dirty_pilot WHERE user_id=ANY(:ids)"), params)
+    await session.commit()
+    # Both timestamps come from PostgreSQL; host/container clocks may differ.
+    now = await session.scalar(text("SELECT clock_timestamp()"))
+    await session.commit()
+    return [
+        {
+            "user_id": r.user_id,
+            "queue_age_ms": (now - r.changed_at).total_seconds() * 1000,
+        }
+        for r in rows
+    ]
+
+
+def latest_assessments(filtered_pilot_ids, as_of_date: date | None):
+    if as_of_date is None:
+        return (
+            select(latest.c.user_id.label("pilot_id"), latest.c.assessment_id)
+            .join(filtered_pilot_ids, filtered_pilot_ids.c.pilot_id == latest.c.user_id)
+            .subquery("latest_assessments")
+        )
+    boundary = datetime.combine(as_of_date + timedelta(days=1), time.min, tzinfo=UTC)
+    ranked = (
+        select(
+            facts.c.user_id.label("pilot_id"),
+            facts.c.assessment_id,
+            func.row_number()
+            .over(
+                partition_by=facts.c.user_id,
+                order_by=(
+                    facts.c.effective_at.desc(),
+                    facts.c.assessment_created_at.desc(),
+                    facts.c.assessment_id.desc(),
+                ),
+            )
+            .label("rn"),
+        )
+        .join(filtered_pilot_ids, filtered_pilot_ids.c.pilot_id == facts.c.user_id)
+        .where(facts.c.effective_at < boundary)
+        .subquery()
+    )
+    return (
+        select(ranked.c.pilot_id, ranked.c.assessment_id)
+        .where(ranked.c.rn == 1)
+        .subquery("latest_assessments")
+    )
+
+
+def latest_grades(assessments, airline_id):
+    from app.modules.training.models import Competence
+
+    return (
+        select(*grades.c, literal(1).label("rn"))
+        .join(assessments, assessments.c.assessment_id == grades.c.assessment_id)
+        .join(Competence, Competence.id == grades.c.competence_id)
+        .where(Competence.airline_id == airline_id)
+        .subquery("latest_final_reports_ranked")
+    )
