diff --git a/app/modules/training/services/scenario_patch.py b/app/modules/training/services/scenario_patch.py
new file mode 100644
index 0000000..7cf38de
--- /dev/null
+++ b/app/modules/training/services/scenario_patch.py
@@ -0,0 +1,81 @@
+"""Experimental atomic exercise patch; same domain validation, lease and scenario CAS as snapshot."""
+
+from pydantic import Field
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+from app.schemas.api_model import ApiModel
+from app.modules.training import models
+from app.modules.training.access import ensure_airline, resolve_aircraft_filter
+from app.modules.training.errors import (
+    ExerciseInvalidModuleError,
+    ExerciseNotFoundError,
+)
+from app.modules.training.schemas import ExerciseUpdate
+from app.modules.training.services.content_mutations import (
+    maybe_apply_legacy_content_mutation_contract,
+)
+from app.modules.training.services.exercises import update_exercise_in_transaction
+from app.modules.training.services.scenarios import get_scenario
+from app.modules.users.models import User
+
+
+class ExercisePatch(ApiModel):
+    exercise_id: int
+    changes: ExerciseUpdate
+
+
+class ScenarioPatch(ApiModel):
+    expected_version: int = Field(ge=0)
+    edits: list[ExercisePatch] = Field(min_length=1, max_length=1000)
+
+
+async def apply_patch(
+    scenario_id: int,
+    payload: ScenarioPatch,
+    client_session_id: str,
+    session: AsyncSession,
+    user: User,
+):
+    await get_scenario(
+        session, scenario_id, ensure_airline(user), resolve_aircraft_filter(user, None)
+    )
+    ids = [e.exercise_id for e in payload.edits]
+    if len(ids) != len(set(ids)):
+        raise ExerciseInvalidModuleError()
+    actual = set(
+        (
+            await session.scalars(
+                select(models.Exercise.id)
+                .join(models.Module)
+                .where(
+                    models.Module.scenario_id == scenario_id,
+                    models.Exercise.id.in_(ids),
+                )
+            )
+        ).all()
+    )
+    if actual != set(ids):
+        raise ExerciseNotFoundError()
+    version = await maybe_apply_legacy_content_mutation_contract(
+        session,
+        scenario_id=scenario_id,
+        current_user=user,
+        client_session_id=client_session_id,
+        expected_version=payload.expected_version,
+    )
+    for edit in payload.edits:
+        await update_exercise_in_transaction(
+            edit.exercise_id,
+            payload=edit.changes,
+            expected_version=None,
+            client_session_id=None,
+            session=session,
+            current_user=user,
+            apply_content_contract=False,
+        )
+    await session.commit()
+    return {
+        "scenario_id": scenario_id,
+        "content_version": version,
+        "updated_exercise_ids": ids,
+    }
diff --git a/tests/test_commander_analytics_optimized.py b/tests/test_commander_analytics_optimized.py
new file mode 100644
index 0000000..e6794d3
--- /dev/null
+++ b/tests/test_commander_analytics_optimized.py
@@ -0,0 +1,81 @@
+from datetime import date
+import pytest
+from sqlalchemy import text
+from app.modules.commander import analytics_optimized as opt
+from app.modules.commander.service import (
+    get_airline_competency_grade_distribution as distribution,
+)
+from tests.test_commander_analytics_projection import seed
+
+
+@pytest.mark.asyncio
+async def test_optimized_source_preserves_latest_asof_and_tenant(db_session):
+    aid, other, users, comp, ts, ass = await seed(db_session)
+    await opt.install(db_session)
+    for tenant in (aid.id, other.id):
+        for cutoff in (None, date(2019, 12, 31), date(2020, 1, 2), date(2021, 1, 1)):
+            kwargs = dict(
+                airline_id=tenant,
+                pilot_public_id=None,
+                aircraft_id=None,
+                age_from_years=None,
+                age_to_years=None,
+                position_id=None,
+                as_of_date=cutoff,
+            )
+            assert await distribution(db_session, **kwargs) == await distribution(
+                db_session, **kwargs, use_optimized=True
+            )
+    kwargs = dict(
+        airline_id=aid.id,
+        pilot_public_id=None,
+        aircraft_id=None,
+        age_from_years=None,
+        age_to_years=None,
+        position_id=None,
+        as_of_date=None,
+    )
+    result = await distribution(db_session, **kwargs, use_optimized=True)
+    assert result["pilots_with_completed_training"] == 2 and result["items"]
+    await db_session.execute(
+        text(
+            "UPDATE final_report SET grade='4',grade_code_snapshot='4' WHERE assessment_id=:a"
+        ),
+        {"a": ass[4].id},
+    )
+    await db_session.commit()
+    assert await distribution(db_session, **kwargs) == await distribution(
+        db_session, **kwargs, use_optimized=True
+    )
+
+
+@pytest.mark.asyncio
+async def test_optimized_source_handles_status_change_and_deletion_immediately(
+    db_session,
+):
+    aid, other, users, comp, ts, ass = await seed(db_session)
+    await opt.install(db_session)
+    kwargs = dict(
+        airline_id=aid.id,
+        pilot_public_id=None,
+        aircraft_id=None,
+        age_from_years=None,
+        age_to_years=None,
+        position_id=None,
+        as_of_date=None,
+    )
+    await db_session.execute(
+        text("UPDATE training_session SET status='IN_PROGRESS' WHERE id=:id"),
+        {"id": ts[4].id},
+    )
+    await db_session.commit()
+    assert await distribution(db_session, **kwargs) == await distribution(
+        db_session, **kwargs, use_optimized=True
+    )
+    await db_session.execute(
+        text("DELETE FROM training_session WHERE id=:id"), {"id": ts[3].id}
+    )
+    await db_session.commit()
+    assert await distribution(db_session, **kwargs) == await distribution(
+        db_session, **kwargs, use_optimized=True
+    )
