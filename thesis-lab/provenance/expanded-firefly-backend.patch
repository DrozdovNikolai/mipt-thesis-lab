+"""Opt-in source-table alternative: covering indexes and DISTINCT ON, no read model."""
+
+from sqlalchemy import select, func, literal, text
+from app.modules.training.assessment_models import (
+    TrainingSession,
+    CrewMemberAssessment,
+    FinalReport,
+)
+from app.modules.training.models import Competence
+
+
+INDEXES = [
+    "CREATE INDEX IF NOT EXISTS thesis_assessment_user_training ON crew_member_assessment(user_id,training_session_id,created_at DESC,id DESC)",
+    "CREATE INDEX IF NOT EXISTS thesis_completed_training ON training_session((coalesce(completed_at,updated_at,created_at)) DESC,id) WHERE status='COMPLETED'",
+    """CREATE INDEX IF NOT EXISTS thesis_latest_report ON final_report
+    (assessment_id,competence_id,updated_at DESC,created_at DESC,id DESC)
+    INCLUDE(grade,grade_code_snapshot,grade_label_snapshot,grade_score_snapshot,grade_color_hex_snapshot)""",
+]
+
+
+async def install(session):
+    for ddl in INDEXES:
+        await session.execute(text(ddl))
+    await session.execute(text("ANALYZE"))
+    await session.commit()
+
+
+def latest_assessments(filtered_pilot_ids, as_of_date=None):
+    from app.modules.commander.service import _as_of_date_exclusive_bound
+
+    effective = func.coalesce(
+        TrainingSession.completed_at,
+        TrainingSession.updated_at,
+        TrainingSession.created_at,
+    )
+    q = (
+        select(
+            CrewMemberAssessment.user_id.label("pilot_id"),
+            CrewMemberAssessment.id.label("assessment_id"),
+        )
+        .join(
+            TrainingSession,
+            TrainingSession.id == CrewMemberAssessment.training_session_id,
+        )
+        .join(
+            filtered_pilot_ids,
+            filtered_pilot_ids.c.pilot_id == CrewMemberAssessment.user_id,
+        )
+        .where(TrainingSession.status == "COMPLETED")
+        .distinct(CrewMemberAssessment.user_id)
+        .order_by(
+            CrewMemberAssessment.user_id,
+            effective.desc(),
+            CrewMemberAssessment.created_at.desc(),
+            CrewMemberAssessment.id.desc(),
+        )
+    )
+    if as_of_date is not None:
+        q = q.where(effective < _as_of_date_exclusive_bound(as_of_date))
+    return q.subquery("latest_assessments")
+
+
+def latest_grades(assessments, airline_id):
+    return (
+        select(
+            FinalReport.assessment_id,
+            FinalReport.competence_id,
+            func.coalesce(FinalReport.grade_code_snapshot, FinalReport.grade).label(
+                "grade_code"
+            ),
+            FinalReport.grade_label_snapshot.label("grade_label"),
+            FinalReport.grade_score_snapshot.label("grade_score_numeric"),
+            FinalReport.grade_color_hex_snapshot.label("grade_color_hex"),
+            literal(1).label("rn"),
+        )
+        .join(assessments, assessments.c.assessment_id == FinalReport.assessment_id)
+        .join(Competence, Competence.id == FinalReport.competence_id)
+        .where(Competence.airline_id == airline_id)
+        .distinct(FinalReport.assessment_id, FinalReport.competence_id)
+        .order_by(
+            FinalReport.assessment_id,
+            FinalReport.competence_id,
+            FinalReport.updated_at.desc(),
+            FinalReport.created_at.desc(),
+            FinalReport.id.desc(),
+        )
+        .subquery("latest_final_reports_ranked")
+    )
