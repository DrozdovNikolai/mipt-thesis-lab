# Copy to .env, preserving the existing database/storage layout and token keys.
NORTH55_IMAGE=55north-backend:local
NORTH55_ENV_FILE=../.env
NORTH55_NETWORK=replace-with-application-network
NORTH55_MEDIA_VOLUME=replace-with-prepared-media-volume
NORTH55_FEEDBACK_VOLUME=replace-with-prepared-feedback-volume
NORTH55_BACKUPS_VOLUME=replace-with-backup-volume
NORTH55_BIND_HOST=127.0.0.1
NORTH55_HTTP_PORT=8000
ENVIRONMENT=prod
APP_NAME=55north-backend
API_PREFIX=/api
DATABASE_URL=postgresql://replace-user:replace-password@db:5432/replace-database
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-existing-access-key
JWT_REFRESH_SECRET_KEY=replace-with-existing-refresh-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=30
REFRESH_TOKEN_EXP_MINUTES=10080
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-admin-password
ADMIN_EMAIL=admin@example.com
ENABLE_CORS=true
ALLOWED_HOSTS=https://replace-with-client-origin
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_SECOND=20
ENABLE_METRICS=true
LOG_LEVEL=INFO
SENTRY_DSN=
FILE_STORAGE_BACKEND=local
FILE_STORAGE_S3_READ_FALLBACK_LOCAL=false
FILE_STORAGE_S3_DUAL_WRITE_LOCAL=false
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false
S3_MEDIA_PREFIX=media
S3_FEEDBACK_PREFIX=feedback
TRAINING_RUNTIME_WRITE_ENABLED=true
TRAINING_LIVE_CREW_SWAP_ENABLED=true
TRAINING_LIVE_CREW_SWAP_AIRLINE_IDS=
TRAINING_LIVE_CREW_SWAP_CAPABILITY_VERSION=1
TRAINING_QUICK_COMMENTS_ENABLED=true
TRAINING_QUICK_COMMENTS_AIRLINE_IDS=
TRAINING_QUICK_COMMENTS_CONTRACT_VERSION=1
TRAINING_DRAFT_MAX_PAYLOAD_BYTES=2097152
