{
  "name": "55north-commander",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "build:firefly": "npm run build -- --mode firefly",
    "build:55nord": "npm run build -- --mode 55nord",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e:api": "playwright test -c playwright.integration.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:browsers": "playwright test -c playwright.browsers.config.ts",
    "test:native-tabs": "node tests/native/browser-checks.mjs",
    "test:native-zoom": "node tests/native/browser-checks.mjs --zoom",
    "test:native-confirm": "node tests/native/browser-checks.mjs --confirm",
    "test:performance": "playwright test -c playwright.performance.config.ts"
  },
  "dependencies": {
    "@sentry/vue": "11.5.0",
    "@tanstack/vue-query": "5.104.1",
    "chart.js": "4.5.1",
    "pinia": "4.0.3",
    "reka-ui": "2.11.0",
    "vue": "3.5.43",
    "vue-i18n": "11.4.13",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.2.1",
    "@types/node": "24.13.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.11.1",
    "globals": "16.5.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true
  }
}
