tAffiliation","multiple":false,"typeClass":"primitive","value":"Bureau d'Enquêtes et d'Analyses pour la sécurité de l'aviation civile (BEA), France"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"Lionel.Feugere@bea.aero"}}]},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Edon, Mathieu"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Bureau d'Enquêtes et d'Analyses pour la sécurité de l'aviation civile (BEA), France"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Feugère, Lionel"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Bureau d'Enquêtes et d'Analyses pour la sécurité de l'aviation civile (BEA), France"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0003-0883-5224"}}]},{"typeName":"producer","multiple":true,"typeClass":"compound","value":[{"producerName":{"typeName":"producerName","multiple":false,"typeClass":"primitive","value":"Bureau d'enquêtes et d'analyses pour la sécurité de l'aviation civile"},"producerAbbreviation":{"typeName":"producerAbbreviation","multiple":false,"typeClass":"primitive","value":"BEA"},"producerURL":{"typeName":"producerURL","multiple":false,"typeClass":"primitive","value":"https://bea.aero/"},"producerLogoURL":{"typeName":"producerLogoURL","multiple":false,"typeClass":"primitive","value":"https://upload.wikimedia.org/wikipedia/commons/b/ba/Bureau_d%27enqu%C3%AAtes_et_d%27analyses_pour_la_s%C3%A9curit%C3%A9_de_l%27aviation_civile_%28logo%29.svg"}},{"producerName":{"typeName":"producerName","multiple":false,"typeClass":"primitive","value":"DGA Essais propulseurs"},"producerAbbreviation":{"typeName":"producerAbbreviation","multiple":false,"typeClass":"primitive","value":"DGA Ep"}}]},{"typeName":"distributor","multiple":true,"typeClass":"compound","value":[{"distributorName":{"typeName":"distributorName","multiple":false,"typeClass":"primitive","value":"Entrepôt Recherche Data Gouv"},"distributorURL":{"typeName":"distributorURL","multiple":false,"typeClass":"primitive","value":"https://entrepot.recherche.data.gouv.fr"},"distributorLogoURL":{"typeName":"distributorLogoURL","multiple":false,"typeClass":"primitive","value":"https://s3.fr-par.scw.cloud/rdg-portal/logos-macarons/Macarons%20Recherche%20Data%20Gouv_Entrep%C3%B4t.png"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"A cockpit-oriented corpus was recorded, containing French and English pilot vocabulary from French-native speakers (ICAO English median level of 5). It is composed of two sub-corpora, recorded by BEA (civil) and by DGA Essais propulseurs (military).<br>\n<br>\nBEA<br>\nVolunteers (9 males and 3 females; 24- to 64-year-old) with experience as pilots (private, airline, military; median number of flight hours: 475), or as air traffic controllers, were recorded while reading airplane take-off and checklists (Boeing, Airbus; total of 177 min) and non-sensitive transcripts from Airbus airplane CVRs (total of 47 min).\nSpeakers wore a headset to hear their own voice as in a cockpit. The measurements were performed in a room with partial audio treatment on walls and an anti-sound-reflection screen (Reflexound, Plugger Sound) around a low-noise directional microphone (MKH 60 P48, Sennheiser), located at close range from the speaker, and plugged into a portable recorder (H4n Pro, Zoom; 32-bit float wave files at 44.1 kHz.<br>\n<br>\nDGA<br>\nVolunteers (6 males, 22- to 56-year-old) with experience as pilots (private, flight engineer; median number of flight hours: 100), air traffic controllers or CVR analysts, were recorded while reading aircraft checklists (total of 21 min) as well as non-sensitive transcripts (total of 14 min). A portable recorder (H6, Zoom; 16-bit float wave files at 44.1 kHz) and its integrated stereo microphones were used, located at close range from the speaker. Only the left channels were kept."},"dsDescriptionLanguage":{"typeName":"dsDescriptionLanguage","multiple":false,"typeClass":"controlledVocabulary","value":"English"},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2026-03-31"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Computer and Information Science","Engineering"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"aeronautical speech"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"vocal signal"},"keywordTermURL":{"typeName":"keywordTermURL","multiple":false,"typeClass":"primitive","value":"http://data.loterre.fr/ark:/67375/SN8-W0RSBXDP-2"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Signal theory and processing"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https://loterre.istex.fr/SN8"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"speech"},"keywordTermURL":{"typeName":"keywordTermURL","multiple":false,"typeClass":"primitive","value":"http://data.loterre.fr/ark:/67375/QJP-B3HNVFJ8-H"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Engineering sciences vocabu